# Kopiere diese Datei nach cluster.env und trage deine Werte ein.
# cluster.env wird nicht ins Git eingecheckt (steht in .gitignore).

# Pfad zur Med42-GGUF-Datei auf dem Master-Node
MODEL=/path/to/Llama3-Med42-70B.Q4_K_M.gguf

# Pfad zu llama-server Binary (optional, Standard: ~/llama.cpp/build/bin/llama-server)
# LLAMA_SERVER=/path/to/llama-server

# RPC-Nodes: kommagetrennte IP:Port-Paare der Worker-Nodes
# Leer lassen für reinen Lokalbetrieb
RPC_NODES=10.0.0.1:50052,10.0.0.2:50052

# Layer-Verhältnis über die Geräte: Arc,CPU,Node1,Node2,...
# Geräte mit Vulkan-Instabilität: kleinen Wert wählen (z.B. 1 ≈ 3 GB)
# Geräte mit aktiver Nutzung: moderaten Wert wählen (z.B. 4 ≈ 9 GB)
TENSOR_SPLIT=8,4,1,4

# API-Port (Standard: 8080)
# PORT=8080

# Kontextfenster in Tokens — kein künstliches Limit (Standard: 131072)
# CTX_SIZE=131072
