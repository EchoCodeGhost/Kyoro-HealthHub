#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Blocks personal data in commit messages. Enabled together with pre-commit
# via: git config core.hooksPath .githooks
set -euo pipefail
repo_root="$(git rev-parse --show-toplevel)"
python3 "$repo_root/scripts/utils/check_commit_message_privacy.py" "$1"
